+/* ===========================================================================
+ * BM-boot SOC clock configuration (ported from the TI SBL)
+ * ---------------------------------------------------------------------------
+ * The cr60 BootManager (BM) only jumps to the app - it does NOT run the TI SBL's
+ * "default clock configuration". This app, like every mmWave SDK app, relies on
+ * the SBL to bring up the CORE/DSP/PER DPLLs, the R5/SYS clock, the peripheral
+ * clocks AND the RSS (RadarSS/BSS) clock. Without them:
+ *   - RSS clock wrong  -> MMWave_init() fails ("mmWave Control Initialization failed")
+ *   - CORE CLKOUT2 wrong -> MCAN/QSPI (= 80 MHz from 400 MHz/5) dead -> no CAN.
+ *
+ * This is a verbatim port of Bootloader_socConfigurePll() from the MCU+ SDK SBL
+ * (source/drivers/bootloader/soc/awr2x44p/bootloader_soc.c). Only difference:
+ * gCoreBootInfo[R5FSS0_0].defaultClockHz is substituted with its literal value
+ * (400 MHz) since that table lives in the bootloader, not the app.
+ *
+ * NOTE: the R5 itself runs off DPLL_CORE_HSDIV0_CLKOUT2, so the CORE DPLL is
+ * reconfigured with the R5 temporarily switched to XTAL (exactly as the SBL does)
+ * - this is the only safe way to re-lock the PLL the core is running on.
+ * MUST be the very first thing in main(), before System_init()/Drivers_open()
+ * and before any access to the BSS (MMWave_init).
+ * =========================================================================== */
+#define MMWDEMO_R5FSS0_DEFAULT_CLOCK_HZ   (400U * 1000000U)
+
+static void MmwDemo_socConfigurePll(void)
+{
+    SOC_RcmPllHsDivOutConfig hsDivCfg;
+    SOC_RcmEfuseBootFreqConfig bootFreqEfuseCfg;
+    int32_t retVal;
+    uint32_t defaultR5Clk;
+
+    /* Make RCM MMRs writable in case the BootManager left them locked
+     * (the SOC_rcm* helpers also unlock internally, this is belt-and-suspenders). */
+    SOC_controlModuleUnlockMMR(SOC_DOMAIN_ID_MSS_RCM, 0);
+    SOC_controlModuleUnlockMMR(SOC_DOMAIN_ID_MSS_TOP_RCM, 0);
+
+    retVal = SOC_rcmSetHSDivMux(SOC_RcmHSDIVClkOutMuxId_DPLL_CORE_OUT2,
+                                SOC_RcmHSDIVClkOutMuxClockSource_DPLL_CORE_HSDIV0_CLKOUT2_PreMux);
+    DebugP_assert(retVal == SystemP_SUCCESS);
+
+    /* DSP DPLL = 900 MHz, CLKOUT1 = 450 MHz */
+    hsDivCfg.hsdivOutEnMask = (SOC_RCM_PLL_HSDIV_OUTPUT_ENABLE_1);
+    hsDivCfg.hsDivOutFreqHz[1] = SOC_RCM_FREQ_MHZ2HZ(450U);
+    SOC_rcmDspPllConfig(SOC_RcmPllFoutFreqId_CLK_900MHZ, &hsDivCfg);
+    retVal = SOC_rcmSetHSDivMux(SOC_RcmHSDIVClkOutMuxId_DPLL_DSP_OUT1,
+                        SOC_RcmHSDIVClkOutMuxClockSource_DPLL_DSP_HSDIV0_CLKOUT1_PreMux);
+    DebugP_assert(retVal == SystemP_SUCCESS);
+    retVal = SOC_rcmSetHSDivMux(SOC_RcmHSDIVClkOutMuxId_DPLL_DSP_OUT2,
+                        SOC_RcmHSDIVClkOutMuxClockSource_DPLL_DSP_HSDIV0_CLKOUT2_PreMux);
+    DebugP_assert(retVal == SystemP_SUCCESS);
+
+    /* PER DPLL = 1600 MHz, CLKOUT1 = 200 MHz (feeds RSS clock + SCIA) */
+    hsDivCfg.hsdivOutEnMask = SOC_RCM_PLL_HSDIV_OUTPUT_ENABLE_1;
+    hsDivCfg.hsDivOutFreqHz[1] = SOC_RCM_FREQ_MHZ2HZ(200U);
+    SOC_rcmPerPllConfig(SOC_RcmPllFoutFreqId_CLK_1600MHZ, &hsDivCfg);
+    retVal = SOC_rcmSetHSDivMux(SOC_RcmHSDIVClkOutMuxId_DPLL_PER_OUT1,
+                        SOC_RcmHSDIVClkOutMuxClockSource_DPLL_PER_HSDIV0_CLKOUT1_PreMux);
+    DebugP_assert(retVal == SystemP_SUCCESS);
+
+    SOC_rcmGetEfuseBootFrequency(&bootFreqEfuseCfg);
+    SOC_rcmSetR5Clock(bootFreqEfuseCfg.r5FreqHz, bootFreqEfuseCfg.sysClkFreqHz);
+
+    /* NOTE: RSS (BSS) clock is intentionally NOT set here. The cr60 reference app
+     * (proven on this same BootManager, also using RadarSS) never programs the RSS
+     * clock - the BootManager provides it when it runs the RSS core. Programming it
+     * from here would touch an already-running BSS. SCIA is also left to the app's
+     * own PowerClock_init() (ti_power_clock_config.c) to avoid double-configuration. */
+
+    /* Switch R5F clock source to XTAL before re-locking the CORE DPLL it runs on */
+    SOC_rcmSwitchR5Clock(SOC_RcmR5ClockSource_XTAL_CLK, 0U);
+
+    /* CORE DPLL = 800 MHz: CLKOUT1 = 200 MHz (SYS), CLKOUT2 = 400 MHz (R5 + MCAN/QSPI src) */
+    hsDivCfg.hsdivOutEnMask = (SOC_RCM_PLL_HSDIV_OUTPUT_ENABLE_1 |
+                               SOC_RCM_PLL_HSDIV_OUTPUT_ENABLE_2);
+    hsDivCfg.hsDivOutFreqHz[1] = SOC_RCM_FREQ_MHZ2HZ(200);
+    hsDivCfg.hsDivOutFreqHz[2] = MMWDEMO_R5FSS0_DEFAULT_CLOCK_HZ;
+    SOC_rcmCoreDpllConfig(SOC_RcmPllFoutFreqId_CLK_800MHZ, &hsDivCfg);
+
+    retVal = SOC_rcmSetHSDivMux(SOC_RcmHSDIVClkOutMuxId_DPLL_CORE_OUT2,
+                                SOC_RcmHSDIVClkOutMuxClockSource_DPLL_CORE_HSDIV0_CLKOUT2_PreMux);
+    DebugP_assert(retVal == SystemP_SUCCESS);
+
+    /* Switch R5F clock source back to CORE DPLL HSDIV0 CLKOUT2 */
+    SOC_rcmSwitchR5Clock(SOC_RcmR5ClockSource_DPLL_CORE_HSDIV0_CLKOUT2, 0U);
+
+    defaultR5Clk = MMWDEMO_R5FSS0_DEFAULT_CLOCK_HZ;
+    SOC_rcmSetR5Clock(defaultR5Clk, defaultR5Clk / 2U);
+
+    (void)retVal;
+}
